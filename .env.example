# Souq Pi - Environment Configuration
# Copy this file to .env.local and update with your actual values

# ========================================
# Pi Network Configuration
# ========================================
# Set to 'testnet' or 'mainnet'
PI_NETWORK=testnet

# Pi Application Credentials (from Pi Developer Portal)
# Only PI_API_KEY is required (PI_APP_SECRET is deprecated)
PI_APP_ID=your_app_id_here
PI_API_KEY=your_api_key_here

# Optional: Override default API endpoints
# PI_API_BASE_URL=https://api.minepi.com
# PI_HORIZON_URL=https://api.testnet.minepi.com
# PI_NETWORK_PASSPHRASE=Pi Testnet
# PI_API_VERSION=v2

# ========================================
# Server Wallet Configuration
# ========================================
# Pi Wallet keys for server-side transactions and refunds
SERVER_WALLET_PUBLIC_KEY=your_server_public_key_here
SERVER_WALLET_SECRET_KEY=your_server_secret_key_here

# ========================================
# Database Configuration
# ========================================
# MongoDB connection string
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/souq-pi?retryWrites=true&w=majority

# ========================================
# Security Configuration
# ========================================
# JWT Secret for authentication
JWT_SECRET=your_jwt_secret_key_here

# Admin Secret for admin panel access
ADMIN_SECRET=your_admin_secret_here

# ========================================
# Cloudinary Configuration (for image uploads)
# ========================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ========================================
# Refund Configuration
# ========================================
# Maximum number of automatic refund retry attempts
REFUND_MAX_RETRIES=2

# Delay (in milliseconds) between refund retry attempts
REFUND_RETRY_DELAY_MS=5000

# Timeout (in milliseconds) for manual refund review
REFUND_MANUAL_TIMEOUT_MS=30000

# ========================================
# Logging Configuration
# ========================================
# Log level: 'error', 'warn', 'info', 'debug'
LOG_LEVEL=info

# ========================================
# Next.js Public Configuration
# ========================================
# These variables are exposed to the browser (prefixed with NEXT_PUBLIC_)
NEXT_PUBLIC_PI_NETWORK=testnet
NEXT_PUBLIC_PI_APP_ID=your_app_id_here
